i.github.com/users/OneRobotAI/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"OneRobotAI","id":275164628,"node_id":"U_kgDOEGat1A","avatar_url":"https://avatars.githubusercontent.com/u/275164628?v=4","gravatar_id":"","url":"https://api.github.com/users/OneRobotAI","html_url":"https://github.com/OneRobotAI","followers_url":"https://api.github.com/users/OneRobotAI/followers","following_url":"https://api.github.com/users/OneRobotAI/following{/other_user}","gists_url":"https://api.github.com/users/OneRobotAI/gists{/gist_id}","starred_url":"https://api.github.com/users/OneRobotAI/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/OneRobotAI/subscriptions","organizations_url":"https://api.github.com/users/OneRobotAI/orgs","repos_url":"https://api.github.com/users/OneRobotAI/repos","events_url":"https://api.github.com/users/OneRobotAI/events{/privacy}","received_events_url":"https://api.github.com/users/OneRobotAI/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"7a3ef071f682bda48ee5cb9dde42ca9eaa290f99","url":"https://api.github.com/repos/OneRobotAI/lelab/commits/7a3ef071f682bda48ee5cb9dde42ca9eaa290f99","html_url":"https://github.com/OneRobotAI/lelab/commit/7a3ef071f682bda48ee5cb9dde42ca9eaa290f99"}],"stats":{"total":47,"additions":44,"deletions":3},"files":[{"sha":"3be3774b61915145034597d5c8dd1c5170656f9b","filename":"README.md","status":"modified","additions":44,"deletions":3,"changes":47,"blob_url":"https://github.com/OneRobotAI/lelab/blob/9a182993a2a9a3b04312c13ff8365f68d379fe80/README.md","raw_url":"https://github.com/OneRobotAI/lelab/raw/9a182993a2a9a3b04312c13ff8365f68d379fe80/README.md","contents_url":"https://api.github.com/repos/OneRobotAI/lelab/contents/README.md?ref=9a182993a2a9a3b04312c13ff8365f68d379fe80","patch":"@@ -59,19 +59,60 @@\n - **Git**\n - **SO-101 机械臂的 USB 串口驱动**（Windows 需安装 CH340/CP2102 驱动）\n \n-### 通用方式（uv 推荐，三平台通用）\n+### 安装 uv\n+\n+LeLab 推荐用 **uv**（极速的 Python 包管理器）安装和运行。按平台选择：\n+\n+**Windows（PowerShell）**\n+```powershell\n+# 方式一：winget\n+winget install --id=astral-sh.uv  -e\n+\n+# 方式二：官方安装脚本\n+powershell -c \"irm https://astral.sh/uv/install.ps1 | iex\"\n+```\n \n+**macOS**\n ```bash\n-# 安装 uv（如果还没有）\n-pip install uv\n+# 方式一：Homebrew\n+brew install uv\n+\n+# 方式二：官方安装脚本\n+curl -LsSf https://astral.sh/uv/install.sh | sh\n+```\n+\n+**Ubuntu / Linux**\n+```bash\n+# 方式一：官方安装脚本\n+curl -LsSf https://astral.sh/uv/install.sh | sh\n+# 脚本会把 uv 安装到 ~/.local/bin，重启终端或执行 source ~/.local/bin/env\n+\n+# 方式二：apt（Ubuntu 24.10+）\n+sudo apt install uv\n \n+# 方式三：cargo\n+cargo install --git https://github.com/astral-sh/uv uv\n+```\n+\n+安装后验证：\n+```bash\n+uv --version\n+```\n+\n+> 如果系统已有旧版 uv，升级用 `uv self update`（三平台通用）。\n+\n+### 通用方式（uv 推荐，三平台通用）\n+\n+```bash\n # 安装 LeLab\n uv tool install git+https://github.com/OneRobotAI/lelab.git\n \n # 启动（自动打开浏览器）\n lelab\n ```\n \n+> 提示：uv 会在 `~/.local/share/uv/tools/`（Windows 为 `%APPDATA%\\uv\\tools\\`）下创建独立环境安装 LeLab，`lelab` 命令会自动加入 PATH。\n+\n ---\n \n ## Windows 安装"}]}